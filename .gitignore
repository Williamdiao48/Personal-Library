# Dependencies
node_modules/

# Build output (electron-vite → out/, electron-builder → dist/)
out/
dist/
dist-electron/

# Test / coverage artifacts
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Local node-gyp venv (setuptools shim for Python 3.12+; see docs/testing.md)
.gyp-venv/

# SQLite database files (user data — never commit)
*.db
*.db-journal
*.db-wal
*.db-shm
# ...except the bundled read-only WordNet dictionary, a committed build artifact
# (see scripts/dictionary/build.mjs).
!resources/dictionary/dictionary.db

# Environment / secrets — never commit ANY env file, including .env.example
# templates (user rule 2026-07-27). Scaffold example files locally; don't track.
.env
.env.*

# Cloud service-account / credential key files. The Phase 4 GCP runbook mints
# sa-key.json in the repo root before it's stored as a Supabase secret + rm'd;
# this is belt-and-suspenders so a stray key can never be staged (the rm is the
# primary safeguard). Narrow patterns so package.json/tsconfig.json are unaffected.
sa-key.json
*-key.json
*service-account*.json
gcp-*.json
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Vite local overrides
*.local

# IDE
.vscode/
.idea/

# Claude Code local config — slash commands (.claude/commands/), local settings,
# scheduled tasks. Personal workflow tooling; kept local, never published.
.claude/

# electron-builder cache
.cache/

# Vendored ML model — ~35 MB, no git-lfs here; run `npm run fetch:model` to
# populate. See scripts/ml/fetch-embedding-model.mjs.
resources/models/

# Internal docs — never publish (architecture/parser references, planning,
# audits, and the development journal). See docs/internal/README.md.
docs/internal/

# Internal security audit — kept local only, must never be committed/published.
security.md

# Cloud Phase 0 throwaway spikes (R2 / Turso de-risking experiments). Own
# package.json + creds; never ship. See docs/internal/planning/cloud/phase-0-foundations.md.
spikes/

# Throwaway eyeball-gate harnesses — opt-in, run against a COPY of the real
# library. Named *.harness.test.ts so vitest can run them by path, but never
# committed (they embed with the real model and read the user's real content).
*.harness.test.ts

# Throwaway exit-gate spikes against REAL cloud infra (network/creds required).
# Named *.spike.test.ts so vitest can run them by path, but never committed or
# run in CI (env-gated). See docs/internal/planning/cloud/ (Phase 3 Chunk 6).
*.spike.test.ts
